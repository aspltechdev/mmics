# =====================================================
# SERVER
# =====================================================
PORT=5000
NODE_ENV=development

# =====================================================
# DATABASE
# =====================================================
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# =====================================================
# JWT
# Generate one with:  openssl rand -base64 48
# =====================================================
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRE="7d"

# =====================================================
# IMAGE STORAGE
# =====================================================
# Leave the Cloudinary values blank to store uploads on disk
# in backend/uploads (served from /uploads). Fill them in to
# switch to Cloudinary. No code change is needed either way.
#
# Force a driver with STORAGE_DRIVER=local | cloudinary
STORAGE_DRIVER=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# =====================================================
# EMAIL (SMTP)
# =====================================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="MMMICS Limited <noreply@mmmicslimited.com>"

# =====================================================
# FIRST ADMIN (used by npm run db:seed)
# =====================================================
ADMIN_EMAIL="admin@mmmicslimited.com"
ADMIN_PASSWORD="ChangeThisPassword123!"

# Demo member created by the seed script
DEMO_MEMBER_EMAIL="member@mmmicslimited.com"
DEMO_MEMBER_PASSWORD="ChangeThisPassword123!"

# =====================================================
# URLS
# FRONTEND_URL accepts a comma-separated list of origins
# =====================================================
FRONTEND_URL="http://localhost:5173"
BACKEND_URL="http://localhost:5000"

# =====================================================
# PERFORMANCE TUNING
# =====================================================
# Dashboard stats cache lifetime in milliseconds
DASHBOARD_CACHE_MS=15000
# Log any query slower than this many milliseconds (dev only)
SLOW_QUERY_MS=300

# =====================================================
# COMPANY INFO
# =====================================================
COMPANY_NAME="MMMICS Limited"
COMPANY_PHONE="0484 265 4871"
COMPANY_EMAIL="info@mmmicslimited.com"
COMPANY_ADDRESS="Kadavanthara, Ernakulam, Kerala"
