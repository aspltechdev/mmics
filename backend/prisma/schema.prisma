generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String    @id @default(cuid())
  name        String
  email       String    @unique
  password    String
  role        Role      @default(EDITOR)
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  enquiries   Enquiry[] @relation("AssignedEnquiries")
  news        News[]

  @@index([isActive])
  @@map("users")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
  MEMBER
}

model Category {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  description   String?
  image         String?
  imagePublicId String?
  isActive      Boolean   @default(true)
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  products      Product[]

  @@index([isActive, sortOrder])
  @@index([sortOrder])
  @@map("categories")
}

model Product {
  id               String         @id @default(cuid())
  name             String
  slug             String         @unique
  categoryId       String
  shortDescription String?
  fullDescription  String?
  material         String?
  specifications   Json?
  applications     String[]
  moq              String?
  customization    String?
  isFeatured       Boolean        @default(false)
  isActive         Boolean        @default(true)
  sortOrder        Int            @default(0)
  seoTitle         String?
  seoDescription   String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  enquiries        Enquiry[]
  images           ProductImage[]
  category         Category       @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@index([isActive, createdAt(sort: Desc)])
  @@index([isActive, isFeatured])
  @@index([categoryId, isActive, sortOrder])
  @@index([createdAt(sort: Desc)])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  publicId  String
  altText   String?
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@index([productId, isPrimary])
  @@map("product_images")
}

model Enquiry {
  id            String        @id @default(cuid())
  productId     String?
  name          String
  company       String?
  email         String
  phone         String
  quantity      String?
  requirements  String?
  message       String?
  status        EnquiryStatus @default(NEW)
  assignedToId  String?
  internalNotes String?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  assignedTo    User?         @relation("AssignedEnquiries", fields: [assignedToId], references: [id])
  product       Product?      @relation(fields: [productId], references: [id])

  @@index([status, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([productId])
  @@index([assignedToId])
  @@map("enquiries")
}

enum EnquiryStatus {
  NEW
  CONTACTED
  IN_PROGRESS
  QUOTED
  CONVERTED
  CLOSED
}

model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  status    ContactStatus @default(NEW)
  ipAddress String?
  userAgent String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("contact_messages")
}

enum ContactStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
}

model Director {
  id            String   @id @default(cuid())
  name          String
  designation   String
  qualification String?
  experience    String?
  biography     String?
  photo         String?
  photoPublicId String?
  linkedinUrl   String?
  displayOrder  Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isActive, displayOrder])
  @@map("directors")
}

model GalleryImage {
  id          String          @id @default(cuid())
  title       String?
  description String?
  url         String
  publicId    String
  category    GalleryCategory
  isFeatured  Boolean         @default(false)
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([category, sortOrder])
  @@index([isFeatured, sortOrder])
  @@map("gallery_images")
}

enum GalleryCategory {
  PRODUCTS
  MANUFACTURING
  FACILITIES
  EVENTS
  MEETINGS
  COMMUNITY
  CORPORATE
}

model News {
  id                 String    @id @default(cuid())
  title              String
  slug               String    @unique
  excerpt            String?
  content            String
  coverImage         String?
  coverImagePublicId String?
  authorId           String
  category           String?
  isPublished        Boolean   @default(false)
  publishedAt        DateTime?
  seoTitle           String?
  seoDescription     String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  author             User      @relation(fields: [authorId], references: [id])

  @@index([isPublished, publishedAt(sort: Desc)])
  @@index([authorId])
  @@map("news")
}

model Testimonial {
  id            String   @id @default(cuid())
  customerName  String
  designation   String?
  company       String?
  photo         String?
  photoPublicId String?
  testimonial   String
  rating        Int?     @default(5)
  isActive      Boolean  @default(true)
  isFeatured    Boolean  @default(false)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@index([isFeatured, sortOrder])
  @@map("testimonials")
}

model SiteSettings {
  id              String   @id @default(cuid())
  companyName     String   @default("MMMICS Limited")
  tagline         String?  @default("Packaging Solutions for MSMEs")
  logo            String?
  logoPublicId    String?
  favicon         String?
  faviconPublicId String?
  email           String   @default("info@mmmicslimited.com")
  phone           String   @default("0484 265 4871")
  whatsapp        String?
  address         String?  @default("Kadavanthara, Ernakulam, Kerala")
  googleMapsUrl   String?
  facebook        String?
  instagram       String?
  linkedin        String?
  twitter         String?
  youtube         String?
  footerText      String?  @default("MMMICS Limited - Packaging Solutions")
  copyright       String?  @default("© 2024 MMMICS Limited. All rights reserved.")
  metaTitle       String?  @default("MMMICS Limited - Packaging Solutions for MSMEs")
  metaDescription String?  @default("MMMICS Limited is a cooperative organization focused on providing quality packaging solutions for MSMEs, cooperatives, and businesses.")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("site_settings")
}

// ============= MEMBER MODEL =============
model Member {
  id                   String   @id @default(cuid())
  membershipNumber     String   @unique
  name                 String
  email                String   @unique
  password             String
  phone                String?
  address              String?
  profileImage         String?
  profileImagePublicId String?
  membershipType       String?  @default("Regular")
  joinedAt             DateTime @default(now())
  isActive             Boolean  @default(false)
  lastLoginAt          DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([isActive, createdAt(sort: Desc)])
  @@index([name])
  @@index([createdAt(sort: Desc)])
  @@map("members")
}

// ============= HERO SECTION MODEL =============
model Hero {
  id            String    @id @default(cuid())
  title         String    @default("Welcome to MMMICS Limited")
  subtitle      String?   @default("Packaging Solutions for MSMEs, Cooperatives & Businesses")
  ctaText       String    @default("Explore Products")
  ctaLink       String    @default("/products")
  ctaText2      String?   @default("Request a Quote")
  ctaLink2      String?   @default("/quote")
  backgroundImage String?
  backgroundImagePublicId String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("hero")
}